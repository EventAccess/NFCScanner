	)
	(text_box "Adafruit needs additional jumper wire to enable ~{IRQ}.\nAdafruit does not have EEPROM or 5V output (PoE).\nPoE does not have ~{RESET} button.\n\nBoth boards require an additional jumper wire to access the Ethernet ~{RST}. Adafruit has it next to the IRQ pin, PoE has it on a SMT testpoint"
		(exclude_from_sim no)
		(at 195.58 99.06 0)
		(size 60.96 11.43)
		(stroke
			(width -0.0001)
			(type default)
